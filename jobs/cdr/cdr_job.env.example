# Copiar a cdr_job.env (ignorado por git) y completar. chmod 600 cdr_job.env
# Base MySQL del CDR de uContact (solo lectura alcanza)
MYSQL_HOST=192.168.0.10
MYSQL_PORT=3306
MYSQL_USER=cdr_lector
MYSQL_PASSWORD=
MYSQL_DB=uc

# URL del servicio de Cloud Run de la API (sin /api al final) y token compartido
# (Secret Manager: gcloud secrets versions access latest --secret empresas-job-token)
API_URL=https://empresas-api-xxxxxxxxxx-uc.a.run.app
JOB_TOKEN=

# Opcionales
# Consulta del CDR. Debe devolver estas columnas (usar AS si se llaman distinto) y ordenar por calldate.
# Con un %s recibe "desde"; con dos, "desde" y "hasta" (re-proceso sin leer de más).
# CDR_SQL=SELECT uniqueid, calldate, src, dst, duration, billsec, disposition, userfield, peeraccount, accountcode FROM cdr WHERE calldate >= %s AND calldate < %s ORDER BY calldate, uniqueid
# Llamadas por POST
LOTE_TAMANO=2000
# Zona horaria de calldate en MySQL
# CDR_TZ=America/Montevideo
# HTTP_TIMEOUT=120
# HTTP_REINTENTOS=5
